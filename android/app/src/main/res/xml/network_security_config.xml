<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Trust system CAs for all connections (default for HTTPS).
        Explicitly list Supabase and Google domains so the Android WebView
        never blocks them, even on API 24+ where cleartext is restricted.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Supabase backend — REST, Auth, Realtime WebSocket, Storage, Edge Functions -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">supabase.co</domain>
        <domain includeSubdomains="true">supabase.in</domain>
        <domain includeSubdomains="true">cpifzrvgsmoicginrkgj.supabase.co</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Google OAuth & Google APIs -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">accounts.google.com</domain>
        <domain includeSubdomains="true">googleapis.com</domain>
        <domain includeSubdomains="true">maps.googleapis.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Capacitor local dev server (only needed in development) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
